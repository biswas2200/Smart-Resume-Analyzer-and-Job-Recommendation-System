# Which backend parser.py uses to parse resumes: "local" (default -- runs a
# resume-NER model fully offline, no API key or network call needed) or
# "llm" (routes through LLM_PROVIDER below; opt-in, costs money and needs
# network access, but fills in fields the local model can't, e.g. job
# descriptions).
PARSER_BACKEND=local
NER_MODEL_NAME=yashpwr/resume-ner-bert-v2

# Which LLM provider llm_client.py uses for explanation generation
# (explainer.py), and for resume parsing (parser.py) when
# PARSER_BACKEND=llm above: "groq" (default) or "gemini".
LLM_PROVIDER=groq

# Groq — hosts multiple open-weight model families (Llama, Gemma, ...)
# behind one API, so trying a different family (e.g. a Gemma model) is
# just changing GROQ_MODEL below, no code change. Check
# https://console.groq.com/docs/models for current model ids/availability
# before picking one -- Groq deprecates/replaces models over time.
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — only used when LLM_PROVIDER=gemini above. A separate provider
# from Groq/Gemma (Google's own hosted API, own SDK). Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# sentence-transformers model used for skill/role embedding similarity
EMBEDDING_MODEL=all-MiniLM-L6-v2
