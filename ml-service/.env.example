# Which backend parser.py uses to parse resumes: "local" (default -- runs a
# resume-NER model fully offline, no credentials or network call needed) or
# "llm" (routes through LLM_PROVIDER below; opt-in, costs money and needs
# network access, but fills in fields the local model can't, e.g. job
# descriptions).
PARSER_BACKEND=local
# Our fine-tuned teacher (fetch with scripts/fetch_ner_models.sh). Smaller
# alternative: models/ner/student-run1 with revision
# d51d3ca32c2199ebe5114a51dd48c7143f27c1abf6217d3e20333bf5b893d1c1.
NER_MODEL_NAME=models/ner/teacher-run1
# Pin hashed into engine_fingerprint: SHA-256 of model.safetensors for a
# local directory, a commit for a Hugging Face id.
NER_MODEL_REVISION=ab0fd6ea92dee31fed5e3f56a278197e8c55a358df19328a79981b00912fe189

# Which LLM provider llm_client.py uses for the AI engine (extraction for
# non-engineering fields, the Premium coaching narrative): "gemini"
# (default), "groq", or "none" -- the Community Edition: no provider is ever
# built, engineering runs in full, and fields that need the AI engine come
# back locked with lock_reason "community_edition".
LLM_PROVIDER=gemini

# Gemini on Vertex AI -- authenticated with Google Application Default
# Credentials (ADC). There is NO API key to set. One-time setup:
#
#   gcloud auth application-default login      # on a dev machine
#   gcloud config set project <your-project>   # optional convenience
#
# On GCP (Compute Engine / Cloud Run / GKE) the attached service account is
# the credential -- give it the "Vertex AI User" role and set nothing else.
# The two variable names below are the ones gcloud and the google-genai SDK
# already understand, so exporting them in your shell works too.
GOOGLE_CLOUD_PROJECT=
# "global" = Vertex AI's multi-region Gemini endpoint; or a region such as
# asia-south1 / us-central1 to pin traffic.
GOOGLE_CLOUD_LOCATION=global
# gemini-2.5-flash-lite (default) measured identical extraction quality to
# gemini-2.5-flash on the bundled samples at ~1/5 the price; switch to
# gemini-2.5-flash (and the prices below to 0.30 / 2.50) for a slightly
# warmer coaching narrative. scripts/llm_cost_check.py compares them.
GEMINI_MODEL=gemini-2.5-flash-lite
# Thinking budget on every Gemini call. 0 = off (default: neither task here
# needs reasoning, and thinking tokens are billed as output -- the expensive
# side). -1 = send nothing, leave the model's dynamic default (needed for
# models that reject a zero budget, e.g. gemini-2.5-pro).
GEMINI_THINKING_BUDGET=0

# --- LLM cost controls (apply to whichever provider is selected) ---
# Resume text is whitespace-compacted and cut to this many characters
# before the extraction prompt (~4 chars/token). Two pages is 3-6k chars.
LLM_MAX_INPUT_CHARS=16000
# Output ceilings per task (you pay only for what is generated; these stop
# a runaway answer). The narrative prompt itself asks for <=180 words.
LLM_EXTRACT_MAX_OUTPUT_TOKENS=3072
LLM_NARRATE_MAX_OUTPUT_TOKENS=600
# In-process completion cache: an unchanged resume re-analysed on Premium
# costs nothing the second time. 0 disables.
LLM_CACHE_SIZE=256
# List prices used to estimate spend (GET /llm-usage, AnalyzeResponse.llm_usage).
# Defaults: Vertex AI gemini-2.5-flash-lite. Estimates only -- check the
# Cloud Billing report for the real figure.
LLM_INPUT_USD_PER_1M=0.10
LLM_OUTPUT_USD_PER_1M=0.40
# Soft daily cap (estimated USD, UTC day) on what the *free* tier may spend
# on AI extraction; past it, free requests that need the AI engine come
# back locked ("ai_budget_exhausted") until tomorrow. Premium is never
# affected. In-process only -- a brake, not billing. 0 = off.
LLM_DAILY_BUDGET_USD=0

# Groq -- optional alternative provider (LLM_PROVIDER=groq). Hosts multiple
# open-weight model families (Llama, Gemma, ...) behind one API; switching
# families is just changing GROQ_MODEL. Check
# https://console.groq.com/docs/models for current model ids before picking
# one -- Groq deprecates/replaces models over time. Key from
# https://console.groq.com, read from the environment only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# sentence-transformers model used for skill/role embedding similarity
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Commit the embedding model is pinned to (hashed into engine_fingerprint).
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41

# Logging (see README "Logging"): level for the app's loggers, and an
# optional rotating log file. Empty LOG_FILE logs to the console only.
LOG_LEVEL=INFO
LOG_FILE=
